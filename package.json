{
  "name": "pixelcrusher",
  "private": true,
  "version": "0.1.9",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:app": "tauri build --bundles app",
    "build:mac": "bash scripts/build-macos.sh",
    "tauri:build:mac": "bash scripts/build-macos.sh",
    "bundled-tools:prepare": "node scripts/prepare_tauri_bundled_tools.cjs",
    "bundled-tools:check:linux": "node scripts/check_tauri_bundle_tools.cjs --platform linux",
    "bundled-tools:check:windows": "node scripts/check_tauri_bundle_tools.cjs --platform windows",
    "tauri:build:linux": "tauri build --target x86_64-unknown-linux-gnu --bundles appimage,deb",
    "tauri:build:windows": "tauri build --target x86_64-pc-windows-msvc --bundles msi,nsis",
    "version:check": "node scripts/version_sync.cjs --check"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.2.1",
    "@tauri-apps/cli": "^2.10.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gifsicle": "^7.0.1",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "mozjpeg": "^8.0.0",
    "pngcrush-bin": "^7.0.0",
    "pngquant-bin": "^9.0.0",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^3.2.4",
    "zopflipng-bin": "^7.1.0"
  }
}
